# Copy to .env (project root) and fill in. Authentication uses `az login` (DefaultAzureCredential), so no keys here.

# Microsoft Foundry resource endpoint (Content Understanding)
CONTENTUNDERSTANDING_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/

# OpenAI-compatible endpoint of the same Foundry resource + the deployment NAMES you created
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
# Premium model, used only as the baseline in notebook 02
AZURE_OPENAI_PREMIUM_DEPLOYMENT=gpt-5.4

# Content Understanding analyzers reference MODEL names (not deployment names); notebook 02 maps them via update_defaults
CU_COMPLETION_MODEL=gpt-5.4-mini

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=sample-doc-index
# Optional last resort if Entra ID auth is not available on your search service
# AZURE_SEARCH_API_KEY=

# --- MIFlow (mi_project) — all optional, defaults shown ---
# MI_CU_ANALYZER_ID=miSessionAudio
# MI_CU_BASE_ANALYZER=prebuilt-audio
# MI_CU_LOCALES=en-US
# MI_CODER_DEPLOYMENT=gpt-5.4             (defaults to AZURE_OPENAI_PREMIUM_DEPLOYMENT)
# MI_CODER_EFFORT=low
# MI_SUPERVISOR_DEPLOYMENT=gpt-5.4        (defaults to AZURE_OPENAI_PREMIUM_DEPLOYMENT)
# MI_SUPERVISOR_EFFORT=medium
# MI_RESERVED_ANNOMI_IDS=27               (AnnoMI transcripts used as end-to-end gold videos; never few-shot)
# MI_RELAX_X509_STRICT=0                  (set 1 only if a TLS proxy causes CERTIFICATE_VERIFY_FAILED)
