# Copy this file to `.env` in the repository root and fill in your own values.
# Never commit `.env` (it is git-ignored).

# =====================================================================
# Required: your Microsoft Foundry (Azure AI Services) resource
# =====================================================================
# Content Understanding endpoint: Foundry resource > Keys and Endpoint (".services.ai.azure.com")
CONTENTUNDERSTANDING_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/
# OpenAI-compatible endpoint of the same resource (".openai.azure.com")
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/

# Deployment NAMES you created in Foundry (not model names)
# Premium deployment: used by the Coder and Supervisor agents (recommended: gpt-5.4)
AZURE_OPENAI_PREMIUM_DEPLOYMENT=gpt-5.4
# Mini deployment: used by Content Understanding to fill the analyzer fields (summary, target behaviour, clinician speaker)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini

# Content Understanding refers to MODEL names; `setup-analyzer` maps this model name to the deployment above
CU_COMPLETION_MODEL=gpt-5.4-mini
# CU_COMPLETION_DEPLOYMENT=gpt-5.4-mini   (defaults to AZURE_OPENAI_CHAT_DEPLOYMENT)

# =====================================================================
# Authentication: Entra ID by default (run `az login`; needs the "Cognitive Services User"
# role on the resource). To use API keys instead, uncomment these (Foundry > Keys and Endpoint):
# =====================================================================
# CONTENTUNDERSTANDING_API_KEY=
# AZURE_OPENAI_API_KEY=

# =====================================================================
# Optional MI Review Coach settings (defaults shown)
# =====================================================================
# MI_CU_ANALYZER_ID=miSessionAudio
# MI_CU_BASE_ANALYZER=prebuilt-audio
# MI_CU_LOCALES=en-US
# MI_CODER_DEPLOYMENT=gpt-5.4             (defaults to AZURE_OPENAI_PREMIUM_DEPLOYMENT)
# MI_CODER_EFFORT=low                     (low | medium | high | none; use none for non-reasoning models)
# MI_SUPERVISOR_DEPLOYMENT=gpt-5.4        (defaults to AZURE_OPENAI_PREMIUM_DEPLOYMENT)
# MI_SUPERVISOR_EFFORT=medium
# MI_RESERVED_ANNOMI_IDS=27               (AnnoMI transcripts used as end-to-end gold videos; never few-shot)
# MI_RELAX_X509_STRICT=0                  (set 1 only if a TLS-inspecting proxy causes CERTIFICATE_VERIFY_FAILED)

# =====================================================================
# Only for the old notebooks in junk/ (not used by MI Review Coach)
# =====================================================================
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# AZURE_SEARCH_INDEX_NAME=sample-doc-index
